<mxfile host="app.diagrams.net"><diagram name="fig_job_flow" id="fig_job_flow"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" page="0" pageWidth="860" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:15px"&gt;Lab tech or doctor submits&lt;/b&gt;' style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="290" y="10" width="280" height="50" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:15px"&gt;Image to Storage&lt;/b&gt;&lt;br&gt;row in hub_jobs, status queued' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="280" height="60" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:15px"&gt;Trigger sets priority&lt;/b&gt;&lt;br&gt;from the role: doctor 2, others 0' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="290" y="180" width="280" height="60" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:15px"&gt;Board peeks the queue&lt;/b&gt;&lt;br&gt;score = priority x 60 + age (s)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="290" y="270" width="280" height="60" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:15px"&gt;Lane for this&lt;br&gt;job type free?&lt;/b&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=13;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="310" y="360" width="240" height="100" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:15px"&gt;Wait and poll again&lt;/b&gt;&lt;br&gt;the job keeps aging' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=13;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="640" y="375" width="200" height="70" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:15px"&gt;Claim&lt;/b&gt;&lt;br&gt;server allows one running job per lane' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="290" y="490" width="280" height="60" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b style="font-size:15px"&gt;Job type?&lt;/b&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=13;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="330" y="580" width="200" height="90" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b style="font-size:15px"&gt;mark_image on CPU0&lt;/b&gt;&lt;br&gt;img_work marks, uploads PNG,&lt;br&gt;registers the handle' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=13;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="595" width="230" height="75" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b style="font-size:15px"&gt;verify_image on CPU1&lt;/b&gt;&lt;br&gt;decode, read 4 copies,&lt;br&gt;check the Ascon tag' style="rounded=1;a