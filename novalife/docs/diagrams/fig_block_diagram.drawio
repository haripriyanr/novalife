<mxfile host="app.diagrams.net"><diagram name="fig_block_diagram" id="fig_block_diagram"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" page="0" pageWidth="970" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Flutter app" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2.5;verticalAlign=top;align=center;fontStyle=1;fontSize=15;spacingTop=4;fontColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="200" height="330" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:15px"&gt;Lab technician&lt;/b&gt;&lt;br&gt;uploads scan + report' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="25" y="48" width="170" height="80" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:15px"&gt;Doctor&lt;/b&gt;&lt;br&gt;verifies any copy,&lt;br&gt;priority 2' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="25" y="143" width="170" height="80" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:15px"&gt;Patient&lt;/b&gt;&lt;br&gt;own records,&lt;br&gt;consent, audit' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="25" y="238" width="170" height="80" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:15px"&gt;Share channel&lt;/b&gt;&lt;br&gt;WhatsApp, e-mail,&lt;br&gt;screenshot, resize, JPEG&lt;br&gt;&lt;i&gt;the copy leaves DICOM&lt;/i&gt